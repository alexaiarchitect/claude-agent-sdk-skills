# Agent SDK eval gate, pr tier.
#
# Generated by the `agent-sdk` Claude Code plugin (`/agent-sdk:eval-ci`). Edit it
# freely; regenerating with `--force` replaces it.
#
# The gate is the runner copy committed in this repository under
# `evals/runner/agent_sdk_evals`, run as a module. Its exit code is the verdict:
#
#   0  every case at or above its tier threshold
#   1  a case below threshold                       -> this job fails
#   2  the runner could not run (import, credential) -> this job fails
#   3  inconclusive: nothing could be scored, because a usage limit was
#      rejected, a cost ceiling was hit, or a judge was unreachable
#                                                    -> warning, job stays green
#
# Exit 3 is deliberately neutral. A suite that could not score anything has not
# found a regression, and a gate that goes red for a quota problem is a gate
# people learn to ignore. Three parts implement that:
#
#   1. the run step traps the runner's code, publishes it as a step output, and
#      converts 3 into a `::warning` annotation and its own exit 0;
#   2. `continue-on-error: true` keeps exit 1 or 2 from aborting the job before
#      the results are uploaded;
#   3. the final step reads the published code and fails the job on 1 or 2 only.
#
# Credentials: CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token` and is
# tied to the Claude subscription of whoever ran that command, so it belongs in
# a personal repository rather than an organization-wide secret. For an
# organization, uncomment ANTHROPIC_API_KEY and comment the token out; runs then
# bill the API and `--max-cost-usd` means money rather than plan quota.
name: Agent evals (pr)

on:
  pull_request:
  workflow_dispatch:

# A new push to the same ref supersedes the run in flight: every case is a real
# model session, and finishing a superseded run spends quota for nothing.
concurrency:
  group: agent-evals-pr-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  pr-tier:
    name: "{{PROJECT_NAME}}: pr tier"
    runs-on: ubuntu-latest
    timeout-minutes: {{TIMEOUT_MINUTES}}
    steps:
      - uses: actions/checkout@v6

      - uses: actions/setup-python@v5
        with:
          python-version: "{{PYTHON_VERSION}}"
{{PIP_CACHE}}
      - name: Install dependencies
        run: {{INSTALL_COMMAND}}

      - name: Run the pr tier
        id: evals
        continue-on-error: true
        env:
{{CREDENTIAL_ENV}}
          CLAUDE_MODEL: "{{MODEL}}"
          # The runner package is not installed; it is imported from the copy in
          # this repository, and `.` makes the agent module importable beside it.
          PYTHONPATH: evals/runner:.
        run: |
          set +e
          python -m agent_sdk_evals run evals \
            --tier pr \
            --concurrency 1 \
            --max-cost-usd {{MAX_COST}} \
            --json
          code=$?
          set -e
          echo "exit_code=$code" >> "$GITHUB_OUTPUT"
          if [ "$code" -eq 3 ]; then
            echo "::warning title=Evals inconclusive::The suite could not score every case (usage limit, cost ceiling or an unreachable judge). Exit 3 is not a regression; read the uploaded results."
            exit 0
          fi
          exit "$code"

      - name: Upload results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: agent-evals-pr-${{ github.run_id }}
          path: evals/results/
          if-no-files-found: warn
          retention-days: 14

      - name: Gate on the eval outcome
        if: always()
        env:
          EVAL_EXIT: ${{ steps.evals.outputs.exit_code }}
        run: |
          case "${EVAL_EXIT:-2}" in
            0)
              echo "Every case met its threshold."
              ;;
            3)
              echo "::notice title=Neutral::Inconclusive run; not treated as a regression."
              ;;
            1)
              echo "::error title=Eval failures::At least one case fell below its threshold. Download the results artifact and read aggregate.json."
              exit 1
              ;;
            *)
              echo "::error title=Eval runner error::The runner exited ${EVAL_EXIT:-2}: it could not run the suite at all (credential, import or runner-version problem)."
              exit 1
              ;;
          esac
