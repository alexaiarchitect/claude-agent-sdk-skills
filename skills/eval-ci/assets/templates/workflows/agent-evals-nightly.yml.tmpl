# Agent SDK eval gate, nightly tier.
#
# Generated by the `agent-sdk` Claude Code plugin (`/agent-sdk:eval-ci`).
#
# This is the tier that costs money or quota: judge graders score every case, and
# `--runs {{RUNS}}` repeats each case so a pass *rate* exists rather than a single
# lucky verdict. It runs on a schedule and by hand, never per pull request.
#
# Exit codes and the neutral treatment of 3 are identical to the pr workflow:
# the run step traps the code and publishes it, `continue-on-error: true` keeps
# the artifact upload reachable, and the final step fails on 1 or 2 only. A
# nightly run is more likely to end at 3 than a pr run, because a judge call can
# be rate-limited and the cost ceiling is reached from a larger spend.
#
# `cancel-in-progress` is deliberately absent: two scheduled runs do not race,
# and a manual run should never kill the scheduled one whose results someone is
# waiting for.
#
# Credentials: CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token` and is
# tied to the Claude subscription of whoever ran that command, so it suits a
# personal repository and not an organization-wide secret. Judge calls draw on
# the same plan; `--max-cost-usd` is then an estimate-based ceiling on quota
# rather than on a bill.
name: Agent evals (nightly)

on:
  schedule:
    - cron: "{{CRON}}"
  workflow_dispatch:
    inputs:
      runs:
        description: "Runs per case"
        required: false
        default: "{{RUNS}}"

concurrency:
  group: agent-evals-nightly
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  nightly-tier:
    name: "{{PROJECT_NAME}}: nightly tier"
    runs-on: ubuntu-latest
    timeout-minutes: {{NIGHTLY_TIMEOUT_MINUTES}}
    steps:
      - uses: actions/checkout@v6

      - uses: actions/setup-python@v5
        with:
          python-version: "{{PYTHON_VERSION}}"
{{PIP_CACHE}}
      - name: Install dependencies
        run: {{INSTALL_COMMAND}}

      - name: Run the nightly tier
        id: evals
        continue-on-error: true
        env:
{{CREDENTIAL_ENV}}
          CLAUDE_MODEL: "{{MODEL}}"
          PYTHONPATH: evals/runner:.
          RUNS: ${{ github.event.inputs.runs || '{{RUNS}}' }}
        run: |
          set +e
          python -m agent_sdk_evals run evals \
            --tier nightly \
            --runs "$RUNS" \
            --concurrency 1 \
            --max-cost-usd {{NIGHTLY_MAX_COST}} \
            --json
          code=$?
          set -e
          echo "exit_code=$code" >> "$GITHUB_OUTPUT"
          if [ "$code" -eq 3 ]; then
            echo "::warning title=Evals inconclusive::The nightly suite could not score every case (usage limit, cost ceiling or an unreachable judge). Exit 3 is not a regression; read the uploaded results."
            exit 0
          fi
          exit "$code"

      - name: Upload results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: agent-evals-nightly-${{ github.run_id }}
          path: evals/results/
          if-no-files-found: warn
          retention-days: 90

      - name: Gate on the eval outcome
        if: always()
        env:
          EVAL_EXIT: ${{ steps.evals.outputs.exit_code }}
        run: |
          case "${EVAL_EXIT:-2}" in
            0)
              echo "Every case met the nightly threshold across every run."
              ;;
            3)
              echo "::notice title=Neutral::Inconclusive run; not treated as a regression."
              ;;
            1)
              echo "::error title=Eval failures::At least one case fell below its nightly threshold. Download the results artifact; pass@k is in aggregate.json."
              exit 1
              ;;
            *)
              echo "::error title=Eval runner error::The runner exited ${EVAL_EXIT:-2}: it could not run the suite at all (credential, import or runner-version problem)."
              exit 1
              ;;
          esac
