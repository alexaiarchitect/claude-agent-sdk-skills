# This project predates the agent.py:build_options() convention, so it names
# its own entry point. The runner reads AGENT_ENTRY when eval_config.json
# does not set `agent`.
AGENT_ENTRY=svc.agent:make

CLAUDE_MODEL=claude-sonnet-5-5

# Leave the key unset to run on the stored claude.ai login; `claude setup-token`
# mints a CLAUDE_CODE_OAUTH_TOKEN for an automated environment.
# ANTHROPIC_API_KEY=
