# Hosted deployments must not use a claude.ai subscription credential:
# Anthropic does not allow third-party products to offer claude.ai login or
# rate limits. Use an API key, a gateway that injects one, or a cloud provider.
#
# Supply exactly one of these from the secret manager, never from the image:
# ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=http://claude-gateway.internal:8080

CLAUDE_MODEL=claude-sonnet-5-5
AGENT_WORK_ROOT=/work

# Telemetry collector for this environment.
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.internal:4318
