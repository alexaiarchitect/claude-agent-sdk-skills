# Model the agent and its evals run on. Pinned so a run and its evals agree.
CLAUDE_MODEL=claude-sonnet-5-5

# Leave unset to run on your Claude subscription (stored `claude login`, or a
# CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`). Setting a key bills the API
# instead, even when you are logged in.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...

# Entry point override, if build_options() is not in agent.py.
# AGENT_ENTRY=agent:build_options
